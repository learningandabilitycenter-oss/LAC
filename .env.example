PAYLOAD_SECRET=replace-with-a-long-random-secret
DATABASE_URL=file:./lac-cms.db
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Production (Vercel): replace DATABASE_URL with a Neon Postgres pooled connection string.
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Vercel Blob storage (auto-added when Blob store is connected in Vercel dashboard).
# BLOB_READ_WRITE_TOKEN=

# Optional: Resend API key for email notifications on enquiry submissions.
# RESEND_API_KEY=
